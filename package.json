{
  "name": "pokemelee",
  "private": true,
  "type": "module",
  "scripts": {
    "data": "bun scripts/fetch-pokemon.ts",
    "battle": "bun scripts/battle.ts",
    "stats": "bun scripts/stats.ts",
    "postinstall": "lefthook install",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "bun run lint && bun run fmt:check && bun run typecheck && bun run test",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "packageManager": "bun@1.4.4"
}

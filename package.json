{
  "name": "pokebrawl",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "bun run check && bun run sprites && vite build && wrangler deploy",
    "data": "bun scripts/fetch-pokemon.ts",
    "sprites": "bun scripts/fetch-sprites.ts",
    "icons": "bun scripts/app-icons.ts",
    "battle": "bun scripts/battle.ts",
    "stats": "bun scripts/stats.ts",
    "postinstall": "lefthook install",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "bun run lint && bun run fmt:check && bun run typecheck && bun run test",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "packageManager": "bun@1.4.4"
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pokebrawl",
  "account_id": "ea93a11f9c4cf5128fd1deffb3908158",
  "compatibility_date": "2026-10-01",
  // The app runs in the browser; the Worker answers the daily ranking under /api and dresses up the home page, in
  // French and in English, for link previews and search engines.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/", "/en", "/en/"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pokebrawl",
      "database_id": "e435d519-51a1-4120-9dca-f5ad782fe51b",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    { "name": "SUBMIT_RATE_LIMITER", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
    { "name": "EVENT_RATE_LIMITER", "namespace_id": "2002", "simple": { "limit": 60, "period": 60 } },
  ],
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
  "workers_dev": true,
  "preview_urls": false,
}
